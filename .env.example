# ============================================================================
# EcoSort ML (T237) - Environment Configuration Example
# ============================================================================
APP_NAME="EcoSort ML — Smart Waste Segregation & Recyclability Classification"
APP_ENV="development"
APP_URL="http://localhost:3000"
LOG_LEVEL="INFO"

BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"

DATABASE_URL="sqlite:///./artifacts/ecosort.db"

MODEL_ONNX_PATH="./artifacts/models/model.onnx"
MODEL_CARD_PATH="./artifacts/models/model_card.json"
METRICS_JSON_PATH="./artifacts/metrics/metrics.json"
TAXONOMY_YAML_PATH="./backend/app/core/taxonomy.yaml"

CONFIDENCE_HIGH=0.80
CONFIDENCE_MIN=0.50
MARGIN_MIN=0.12

MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=25000000
STORE_THUMBNAILS=true
THUMBNAIL_DIR="./artifacts/thumbnails"
THUMBNAIL_MAX_DIM=256

RATE_LIMIT_PREDICT="60/minute"
RATE_LIMIT_DEFAULT="120/minute"

GEMINI_API_KEY="MY_GEMINI_API_KEY"
